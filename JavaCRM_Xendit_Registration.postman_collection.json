						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "company_name",
									"value": "{{company_name}}",
									"type": "text"
								},
								{
									"key": "company_slug",
									"value": "{{company_slug}}",
									"type": "text"
								},
								{
									"key": "company_phone",
									"value": "{{company_phone}}",
									"type": "text"
								},
								{
									"key": "company_email",
									"value": "{{company_email}}",
									"type": "text"
								},
								{
									"key": "company_address",
									"value": "Jl. Jendral Sudirman No. 45, Jakarta",
									"type": "text"
								},
								{
									"key": "admin_email",
									"value": "{{admin_email}}",
									"type": "text"
								},
								{
									"key": "admin_password",
									"value": "{{admin_password}}",
									"type": "text"
								},
								{
									"key": "admin_password_confirmation",
									"value": "{{admin_password}}",
									"type": "text"
								}
