		{
			"name": "03. Webhook Callback Xendit",
			"item": [
				{
					"name": "Xendit Webhook - Payment Capture (SUCCEEDED)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "x-callback-token",
								"value": "{{x_callback_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"paymentCapture\": {\n    \"value\": {\n      \"event\": \"payment.capture\",\n      \"business_id\": \"6094fa76c2fd53701b8e079c\",\n      \"created\": \"2021-12-02T14:52:21.566Z\",\n      \"data\": {\n        \"payment_id\": \"py-1fdaf346-dd2e-4b6c-b938-124c7167a822\",\n        \"business_id\": \"6094fa76c2fd53701b8e079c\",\n        \"status\": \"SUCCEEDED\",\n        \"payment_request_id\": \"pr-1fdaf346-dd2e-4b6c-b938-124c7167a822\",\n        \"request_amount\": 464000,\n        \"customer_id\": \"cust-5ed61c4e-499f-49bd-9d90-f3f45028a7a3\",\n        \"channel_code\": \"BRI_VIRTUAL_ACCOUNT\",\n        \"country\": \"ID\",\n        \"currency\": \"IDR\",\n        \"reference_id\": \"{{invoice_number}}\",\n        \"description\": \"Payment subscription\",\n        \"channel_properties\": {\n          \"failure_return_url\": \"https://xendit.co/failure\",\n          \"success_return_url\": \"https://xendit.co/success\"\n        },\n        \"type\": \"SINGLE_PAYMENT\",\n        \"created\": \"2021-12-02T14:52:21.566Z\",\n        \"updated\": \"2021-12-02T14:52:21.566Z\"\n      }\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/xendit/webhook",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"xendit",
								"webhook"
							]
						},
						"description": "Endpoint Webhook Xendit untuk event payment.capture (Pembayaran Sukses/Lunas)."
