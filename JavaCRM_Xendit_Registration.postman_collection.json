		{
			"name": "02. Cek Status Pembayaran",
			"item": [
				{
					"name": "Halaman Pending Pembayaran",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/register/payment-pending/{{invoice_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"register",
								"payment-pending",
								"{{invoice_id}}"
							]
						},
						"description": "Membuka halaman instruksi pending pembayaran berdasarkan ID invoice."
					},
					"response": []
				},
				{
					"name": "Cek Status Pembayaran (Auto Check)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/register/payment-check/{{invoice_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"register",
								"payment-check",
								"{{invoice_id}}"
							]
						},
						"description": "Mengecek status terkini invoice dari Xendit/database. Jika sudah lunas, user akan otomatis di-login dan di-redirect ke Dashboard."
					},
					"response": []
				}
			]
		},
		{
			"name": "03. Simulasi & Webhook Callback Xendit",
			"item": [
				{
					"name": "Simulasi Pembayaran Berhasil (Developer Helper)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/xendit/simulate-success/{{invoice_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"xendit",
								"simulate-success",
								"{{invoice_id}}"
							]
						},
						"description": "Endpoint helper untuk mensimulasikan pembayaran invoice sukses secara instant saat testing/UAT."
					},
					"response": []
				},
				{
					"name": "Official Xendit Webhook (payment_request.succeeded)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "x-callback-token",
								"value": "{{x_callback_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"event\": \"payment_request.succeeded\",\n    \"data\": {\n        \"id\": \"pr-8123h12k3-mock\",\n        \"reference_id\": \"{{invoice_number}}\",\n        \"status\": \"SUCCEEDED\",\n        \"amount\": 464000,\n        \"currency\": \"IDR\",\n        \"payment_method\": {\n            \"type\": \"VIRTUAL_ACCOUNT\",\n            \"virtual_account\": {\n                \"channel_code\": \"MANDIRI\"\n            }\n        }\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/xendit/webhook",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"xendit",
								"webhook"
							]
						},
						"description": "Endpoint Webhook resmi dari Xendit ketika pembayaran invoice berhasil dilunasi."
					},
					"response": []
				},
				{
					"name": "Standard Xendit Callback (Legacy/Standard Format)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "x-callback-token",
								"value": "{{x_callback_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reference_id\": \"{{invoice_number}}\",\n    \"id\": \"pr-8123h12k3-mock\",\n    \"status\": \"SUCCEEDED\",\n    \"payment_method\": \"VIRTUAL_ACCOUNT\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/xendit/callback",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"xendit",
								"callback"
							]
						},
						"description": "Standard webhook callback endpoint untuk notifikasi status pembayaran Xendit."
