							"raw": "{{base_url}}/register/step1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"register",
								"step1"
							]
						},
						"description": "Mengisi form Step 1 (Informasi Perusahaan dan Administrator Utama). Menyimpan data sementara ke dalam Session."
					},
					"response": []
				},
